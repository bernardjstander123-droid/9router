{
  "version": 2,
  "rewrites": [
    {
      "source": "/v1/chat/completions",
      "destination": "/api/v1/chat/completions"
    },
    {
      "source": "/v1/models",
      "destination": "/api/v1/models"
    },
    {
      "source": "/health",
      "destination": "/api/health"
    }
  ],
  "functions": {
    "api/v1/chat/completions.js": {
      "maxDuration": 300
    },
    "api/v1/models.js": {
      "maxDuration": 20
    },
    "api/health.js": {
      "maxDuration": 20
    }
  }
}